# Copy this file to .env and fill in the values.

# MongoDB connection string (MongoDB Atlas free tier works).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense-dash

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# How long a login lasts.
JWT_EXPIRES_IN=7d

PORT=5000

# Frontend URLs allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:8080,https://expense-dash-visualize.vercel.app
